# Base URL of the Express backend (the Render service).
# Vite inlines this at BUILD time — after changing it on Vercel you must redeploy.
#
# Local development:
VITE_API_BASE_URL=http://localhost:4000
#
# Production, e.g.:
# VITE_API_BASE_URL=https://proposal-api.onrender.com


# Demo build: 1 makes the app answer every API call in the browser — register,
# verification code, sign in, accept — with no server, no database and no email.
# Use it for a static preview deployment. Leave unset (or 0) for the real app.
VITE_DEMO_MODE=0


# Прямые запросы к API вместо прокси. На Vercel фронтенд ходит на свой же
# origin: правило в vercel.json проксирует /api/* на бэкенд. Cookie остаётся
# first-party, CORS не нужен, и браузер не обращается к домену хостинга
# бэкенда напрямую — у части провайдеров он закрыт. Поставьте 1, только если
# фронтенд лежит там, где такого прокси нет.
VITE_API_DIRECT=0
