# ── Runtime ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated exact origins allowed to call this API.
# In production this MUST list your Vercel URL(s); an empty list rejects
# every cross-origin browser request.
# localhost is always allowed while NODE_ENV != production.
ALLOWED_ORIGINS=https://your-proposal.vercel.app,https://proposal.yourdomain.com


# ══ ПОЧТА ════════════════════════════════════════════════════════════
# Транспорты пробуются по очереди, пока письмо не уйдёт:
#   1. brevo   — BREVO_API_KEY, HTTP API (api.brevo.com, порт 443)
#   2. smtp    — SMTP_HOST + SMTP_USER + SMTP_PASS, обычный релей
#   3. resend  — RESEND_API_KEY
# Порядок можно задать вручную: MAIL_PRIMARY=brevo|smtp|resend.
#
# ВАЖНО ПРО ХОСТИНГ. Render (и почти все бесплатные площадки) закрывают
# исходящие SMTP-порты 25/465/587 — соединение просто уходит в таймаут,
# сколько бы правильными ни были логин и пароль. Поэтому в продакшене
# настраивайте вариант 1: HTTPS не блокируется никем.

# ── Вариант 1 (рекомендуется): Brevo HTTP API ────────────────────────
# 1. https://app.brevo.com/settings/keys/api → «Generate a new API key»
#    Ключ начинается с xkeysib-. Это НЕ тот ключ, что на странице /keys/smtp.
# 2. https://app.brevo.com/senders/list → добавьте адрес отправителя и
#    подтвердите его письмом. Brevo, в отличие от Resend, подтверждает
#    отдельный адрес — домен покупать не нужно, годится и gmail.com.
# 3. Поставьте этот же адрес в MAIL_FROM.
# Бесплатный тариф — 300 писем в сутки.
BREVO_API_KEY=
MAIL_FROM=Toshkent Freelance <you@gmail.com>
MAIL_REPLY_TO=

# ── Вариант 2: SMTP-релей (локально или на хостинге без блокировок) ───
# Brevo: SMTP-ключ (xsmtpsib-…) со страницы
#        https://app.brevo.com/settings/keys/smtp
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587           (или 2525, если 587 закрыт)
#   SMTP_USER=xxxxx@smtp-brevo.com   ← логин со страницы SMTP & API
#   SMTP_SECURE=false
# Gmail: пароль приложения с https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com · SMTP_PORT=465 · SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true для порта 465 (implicit TLS), false для 587/2525 (STARTTLS).
SMTP_SECURE=false

# ── Вариант 3: Resend ────────────────────────────────────────────────
# https://resend.com/api-keys — MAIL_FROM обязан быть на ПОДТВЕРЖДЁННОМ
# ДОМЕНЕ. Отдельный адрес на gmail.com Resend подтвердить не умеет и
# отвечает «The gmail.com domain is not verified».
RESEND_API_KEY=

# Какой транспорт пробовать первым. Пусто — по порядку выше.
MAIL_PRIMARY=

# ── Аварийный режим для разработки ───────────────────────────────────
# 1 — если ни один провайдер не настроен, код печатается В КОНСОЛЬ
# СЕРВЕРА (в браузер он не попадает никогда). 0 — регистрация честно
# отказывает.
ALLOW_DEV_EMAIL_CODES=0

# Проверить настройки одной командой:
#   node backend/mail.check.mjs ваш@адрес.com


# ══ DATABASE ═════════════════════════════════════════════════════════
# Postgres connection string. On Render, copy the Internal Database URL from
# the Postgres instance — it is injected automatically by render.yaml.
# Leave empty locally and accounts are held in memory instead (dev only;
# the server refuses to start on memory storage in production).
DATABASE_URL=postgres://username:password@localhost:5432/proposal


# ══ SESSIONS ═════════════════════════════════════════════════════════
# Signs the session JWT and keys the one-time-code digests.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random value is generated at boot and every restart signs
# everyone out and invalidates outstanding codes.
JWT_SECRET=idkwhatshouldiwriteforjwtsecret

# ══ БИРЖА ════════════════════════════════════════════════════════════
# Почта владельца площадки. Аккаунт с этим адресом получает права
# суперадминистратора автоматически — при регистрации и при каждом старте
# сервера. Заблокировать, удалить или разжаловать его нельзя.
OWNER_EMAIL=mmirazizf930@gmail.com

# Каждые сколько суток меняется подборка предложений на главной: 2 или 3.
# Другое значение приводится к 3.
OFFER_ROTATION_DAYS=3

# Сколько карточек показываем одновременно (1–6).
OFFER_SLOTS=3

# Комиссия площадки с суммы сделки. 0.08 = 8%.
PLATFORM_FEE_RATE=0.08
