# ── Runtime ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated exact origins allowed to call this API.
# In production this MUST list your Vercel URL(s); an empty list rejects
# every cross-origin browser request.
# localhost is always allowed while NODE_ENV != production.
ALLOWED_ORIGINS=https://your-proposal.vercel.app,https://proposal.yourdomain.com


# ══ EMAIL ════════════════════════════════════════════════════════════
# The server picks the first transport that is fully configured:
#   1. Resend   (RESEND_API_KEY)
#   2. SMTP     (SMTP_HOST + SMTP_USER + SMTP_PASS) — any mailbox
#   3. dev      nothing configured: the code is printed to this console
#               and shown in the UI, so the flow works out of the box
# SMTP_USER is the mailbox the server sends THROUGH. Recipients are always
# the addresses people register with.
# Configure exactly one of the two real transports. Leave both empty while
# developing.

# ── Option 1: Resend ─────────────────────────────────────────────────
# https://resend.com/api-keys — MAIL_FROM must be on a verified domain.
RESEND_API_KEY=
MAIL_FROM=Northbound Studio <mmirazizf930@gmail.com>
MAIL_REPLY_TO=

# ── Option 2: SMTP (works with any mailbox) ──────────────────────────
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=the 16-character app password (not your account password)
#   MAIL_FROM=Your Name <you@gmail.com>
# Yandex: smtp.yandex.ru:465 · Mail.ru: smtp.mail.ru:465 · Outlook: smtp-mail.outlook.com:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mmirazizf930@gmail.com
SMTP_PASS=idkwhatshouldiwriteforpassword
# true for port 465 (implicit TLS), false for 587 (STARTTLS).
SMTP_SECURE=true


# ══ DATABASE ═════════════════════════════════════════════════════════
# Postgres connection string. On Render, copy the Internal Database URL from
# the Postgres instance — it is injected automatically by render.yaml.
# Leave empty locally and accounts are held in memory instead (dev only;
# the server refuses to start on memory storage in production).
DATABASE_URL=postgres://dc6525b1249275feba6576c15c1d518c2af4765d67346978405ae7ff9909b49a:sk_dYzpyqopoNR8Ai9XHD6Kk@db.prisma.io:5432/postgres?sslmode=require





# ══ SESSIONS ═════════════════════════════════════════════════════════
# Signs the session JWT and keys the one-time-code digests.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random value is generated at boot and every restart signs
# everyone out and invalidates outstanding codes.
JWT_SECRET=idkwhatshouldiwriteforjwtsecret
